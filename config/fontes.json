          "endpoint": "dicionario-despesa",
          "chave": "arquivo",
          "url": "https://arquivos.transparencia.sc.gov.br/transparenciasc/dados-abertos/despesa/dicionario-de-dados/Dicion%C3%A1rio%20de%20Dados%20-Dados%20Abertos%20-%20Despesa%20do%20Poder%20Executivo.pdf",
          "arquivo": "arquivos/despesa/dicionario-de-dados-despesa.pdf"

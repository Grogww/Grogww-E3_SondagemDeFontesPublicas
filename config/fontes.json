            // Despesa por área no exercício (lista "detalhe", por grupo de natureza da despesa).
            { "endpoint": "api-despesa", "porIndicador": true, "url": "api/despesa?indicador={indicador}&anomesinifiltro%5B%5D={ano}01&anomesfimfiltro%5B%5D={ano}12" },
            // Série anual da área desde 2011 ("valoresAno") e valores do mês.
            { "endpoint": "api-despesa-macrocontexto", "porIndicador": true, "url": "api/despesa/macrocontexto?ano={ano}&indicador={indicador}" }
          ],
          // Lista dos arquivos de Dados Abertos de Despesa (grupolink[].links[]: "caminho" e

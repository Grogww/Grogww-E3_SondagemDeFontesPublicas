      // Swagger, securitySchemes. O valor da chave vem só da variável de ambiente.
      "headerChave": "chave-api-dados",
      "variavelChave": "PORTAL_TRANSPARENCIA_CHAVE",
      "parametros": {
        "uf": "SC",
        // Endereço do api-docs não consta da documentação salva (só o da página do Swagger,

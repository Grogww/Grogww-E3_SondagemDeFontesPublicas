      "endpoints": {
        "despesa-mensal": { "recorte": "fonte", "nota": "despesa do Executivo estadual de SC" },
        // API interna não documentada (inspeção do navegador, 2026-11-23). registros: onde está a lista no corpo.
        "api-despesa": { "recorte": "fonte", "registros": "detalhe", "nota": "despesa do Executivo estadual de SC, por grupo de natureza da despesa" },
        // Série e situação da carga: um objeto de agregados por resposta, não uma tabela de registros.
        "api-despesa-macrocontexto": { "recorte": "nao-se-aplica", "nota": "agregados da área (série anual e mensal), não registros" },
        "api-processo-carga": { "recorte": "nao-se-aplica", "nota": "data e situação da última carga da despesa" },
        "api-subareainteresse": { "recorte": "nao-se-aplica", "registros": "grupolink[].links", "nota": "lista dos arquivos de dados abertos (um registro por link)" }
      },
      // Arquivos baixados (BaixarAsync) cujo conteúdo é perfilado: ZIP com CSV, ou CSV solto.
      "arquivos": [
        { "endpoint": "despesa-mensal", "pasta": "arquivos/despesa", "codificacao": "latin1", "separador": ";" }
      ]
    },
    "cnpj": {
      "padrao": { "recorte": "nao-se-aplica" },
      "endpoints": {
        "estabelecimentos": { "recorte": "campo", "campoUf": "uf", "nota": "UF do estabelecimento (cnpj-metadados.pdf, p. 2); amostra Estabelecimentos1, ~1/10 da base do dump 2026-10" },
        // Empresas não têm UF: SC pela junção do CNPJ básico com os estabelecimentos baixados.
        "empresas": {
          "recorte": "juncao", "campoChave": "cnpj_basico",
          "juncao": { "endpoint": "estabelecimentos", "campo": "cnpj_basico" },
          "nota": "SC = ao menos um estabelecimento de SC em Estabelecimentos1; sem UF = CNPJ básico ausente de Estabelecimentos1 (a divisão em partes não garante que Empresas1 e Estabelecimentos1 tragam as mesmas empresas)"
        },
        "dominio-cnaes": { "recorte": "nao-se-aplica" },
        "ecf-lucro-arbitrado": { "recorte": "sem-uf", "nota": "o arquivo não traz UF; cnpj tem 14 dígitos, sem junção configurada" }
      },
      // ZIP da Receita: entradas sem extensão .csv, sem cabeçalho, ";" e campos entre aspas
      // (cnpj-metadados.pdf, p. 5, item 1). Codificação não informada na documentação; conferida nos
      // bytes da execução 20261124-210846: UTF-8 inválido e nenhum byte 0x80-0x9F, compatível com latin1
      // (ISO-8859-1); Cnaes lido em latin1 sai com acentos corretos. Fim de linha LF.
      // Colunas na ordem do layout (cnpj-metadados.pdf, p. 1-2 e 4-5).
      "arquivos": [
        {
          "endpoint": "estabelecimentos", "pasta": "arquivos/2026-10", "arquivo": "^Estabelecimentos[0-9]*[.]zip$",
          "codificacao": "latin1", "separador": ";",
          "colunas": ["cnpj_basico", "cnpj_ordem", "cnpj_dv", "identificador_matriz_filial", "nome_fantasia",
            "situacao_cadastral", "data_situacao_cadastral", "motivo_situacao_cadastral", "nome_cidade_exterior", "pais",
            "data_inicio_atividade", "cnae_fiscal_principal", "cnae_fiscal_secundaria", "tipo_logradouro", "logradouro",
            "numero", "complemento", "bairro", "cep", "uf", "municipio", "ddd_1", "telefone_1", "ddd_2", "telefone_2",
            "ddd_fax", "fax", "correio_eletronico", "situacao_especial", "data_situacao_especial"]
        },
        {
          "endpoint": "empresas", "pasta": "arquivos/2026-10", "arquivo": "^Empresas[0-9]*[.]zip$",
          "codificacao": "latin1", "separador": ";",
          "colunas": ["cnpj_basico", "razao_social", "natureza_juridica", "qualificacao_responsavel", "capital_social",
            "porte_empresa", "ente_federativo_responsavel"]
        },
        {
          "endpoint": "dominio-cnaes", "pasta": "arquivos/2026-10", "arquivo": "^Cnaes[.]zip$",
          "codificacao": "latin1", "separador": ";",
          "colunas": ["codigo", "descricao"]
        },
        // ECF (compartilhamento à parte): CSV com cabeçalho, separador "," e só ASCII, ao contrário dos
